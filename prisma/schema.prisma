// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Org{
  id String @id @default(uuid())
  email String @unique
  password_hash String
  name String
  whatsapp String @unique
  city String
  address String
  created_at DateTime @default(now())
  emailVerifiedAt DateTime?
  // Nullable only for accounts created before verification existed.
  cnpj String? @unique
  status OrgStatus @default(Pending)
  // Snapshot of the BrasilAPI lookup taken at signup, for the reviewer.
  cnpjCheck Json?
  rejectionReason String?
  reviewedAt DateTime?
  documents OrgDocument[]
  pets Pet[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sessions Session[]
  @@index([city, status])
}

model PasswordResetToken{
  id String @id @default(uuid())
  org Org @relation(fields: [orgId], references: [id])
  orgId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  created_at DateTime @default(now())
}

model EmailVerificationToken{
  id String @id @default(uuid())
  org Org @relation(fields: [orgId], references: [id])
  orgId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  created_at DateTime @default(now())
}

model Session{
  id String @id @default(uuid())
  org Org @relation(fields: [orgId], references: [id])
  orgId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?
  created_at DateTime @default(now())
  @@index([orgId])
}

// Kept only until the review decision: approving or rejecting an org deletes
// its files and these rows, so no registration paperwork outlives its use.
model OrgDocument{
  id String @id @default(uuid())
  org Org @relation(fields: [orgId], references: [id])
  orgId String
  kind OrgDocumentKind
  key String
  created_at DateTime @default(now())
  @@unique([orgId, kind])
}

model Pet{
  id String @id @default(uuid())
  name String
  org Org @relation(fields: [orgId], references: [id])
  orgId String
  age Int
  size AnimalSize
  type AnimalType
  bio String? @db.Text
  created_at DateTime @default(now())
  adopted Boolean @default(false)
  images PetImage[]
}

model PetImage{
  id String @id @default(uuid())
  pet Pet @relation(fields: [petId], references: [id])
  petId String
  key String
  url String
  created_at DateTime @default(now())
}

enum OrgStatus {
  Pending
  UnderReview
  Approved
  Rejected
}

enum OrgDocumentKind {
  Statute
  BoardMinutes
}

enum AnimalSize {
  Small
  Medium
  Large
}

enum AnimalType{
  Dog
  Cat
  Bird
  Fish
  Turtle
  Rabbit
  Hamster
  Ferret
  Chinchilla
}